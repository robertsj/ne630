{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ne630:review:f2026:build-report:1.0.0",
  "title": "Submission build/nonexecution report",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "run_id",
    "configuration_id",
    "created_at",
    "assignment_id",
    "submission_record_id",
    "pseudonym",
    "execution_performed",
    "status",
    "reason_code",
    "sandbox",
    "environment",
    "commands",
    "bounded_logs",
    "resource_usage",
    "outputs",
    "contains_source_identifiers"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "pattern": "^BLD-[0-9]{6,}$"},
    "run_id": {"$ref": "#/$defs/run_id"},
    "configuration_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "assignment_id": {"$ref": "#/$defs/assignment_id"},
    "submission_record_id": {"$ref": "#/$defs/submission_record_id"},
    "pseudonym": {"$ref": "#/$defs/pseudonym"},
    "execution_performed": {"type": "boolean"},
    "status": {
      "enum": [
        "NOT_RUN_NO_SANDBOX",
        "NOT_RUN_POLICY",
        "NOT_CHECKABLE",
        "NOT_APPLICABLE",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "BLOCKED_RESOURCE_LIMIT",
        "SANDBOX_ERROR"
      ]
    },
    "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "sandbox": {
      "anyOf": [
        {"$ref": "#/$defs/sandbox"},
        {"type": "null"}
      ]
    },
    "environment": {
      "type": "object",
      "required": ["platform", "tools"],
      "properties": {
        "platform": {"type": "string", "minLength": 1, "maxLength": 256},
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "version": {"type": "string", "minLength": 1, "maxLength": 256},
              "executable_sha256": {"$ref": "#/$defs/sha256"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command_id", "argv", "working_directory", "started_at", "completed_at", "exit_code", "timed_out"],
        "properties": {
          "command_id": {"type": "string", "pattern": "^CMD-[0-9]{6,}$"},
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "maxLength": 4096}
          },
          "working_directory": {"$ref": "#/$defs/relative_path"},
          "started_at": {"$ref": "#/$defs/timestamp"},
          "completed_at": {"$ref": "#/$defs/timestamp"},
          "exit_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
          "timed_out": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "bounded_logs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stream", "artifact", "captured_bytes", "truncated"],
        "properties": {
          "stream": {"enum": ["STDOUT", "STDERR", "COMBINED"]},
          "artifact": {"$ref": "#/$defs/artifact_ref"},
          "captured_bytes": {"type": "integer", "minimum": 0},
          "truncated": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "resource_usage": {
      "anyOf": [
        {
          "type": "object",
          "required": ["wall_seconds", "maximum_rss_bytes", "output_bytes"],
          "properties": {
            "wall_seconds": {"type": "number", "minimum": 0},
            "maximum_rss_bytes": {"type": "integer", "minimum": 0},
            "output_bytes": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "contains_source_identifiers": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {"execution_performed": {"const": false}},
        "required": ["execution_performed"]
      },
      "then": {
        "properties": {
          "status": {"enum": ["NOT_RUN_NO_SANDBOX", "NOT_RUN_POLICY", "NOT_CHECKABLE", "NOT_APPLICABLE"]},
          "sandbox": {"type": "null"},
          "commands": {"maxItems": 0},
          "bounded_logs": {"maxItems": 0},
          "resource_usage": {"type": "null"},
          "outputs": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"execution_performed": {"const": true}},
        "required": ["execution_performed"]
      },
      "then": {
        "properties": {
          "status": {"enum": ["SUCCEEDED", "FAILED", "TIMED_OUT", "BLOCKED_RESOURCE_LIMIT", "SANDBOX_ERROR"]},
          "sandbox": {"$ref": "#/$defs/sandbox"},
          "commands": {"minItems": 1},
          "resource_usage": {
            "type": "object",
            "required": ["wall_seconds", "maximum_rss_bytes", "output_bytes"]
          }
        }
      }
    }
  ],
  "$defs": {
    "run_id": {"type": "string", "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"},
    "assignment_id": {"enum": ["HW01", "HW02", "HW03", "HW04"]},
    "pseudonym": {"type": "string", "pattern": "^S[0-9]{3,}$"},
    "submission_record_id": {"type": "string", "pattern": "^HW0[1-4]-S[0-9]{3,}-V[0-9]{2,}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+)*$"},
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "role", "path", "sha256", "byte_count", "media_type"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^ART-[0-9]{6,}$"},
        "role": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"}
      },
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "required": [
        "verified",
        "profile_id",
        "profile_sha256",
        "wrapper_sha256",
        "approval_decision_id",
        "network",
        "read_only_inputs",
        "resource_limits"
      ],
      "properties": {
        "verified": {"const": true},
        "profile_id": {"type": "string", "pattern": "^SBX-[A-Z0-9-]+$"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "wrapper_sha256": {"$ref": "#/$defs/sha256"},
        "approval_decision_id": {"type": "string", "pattern": "^DEC-[0-9]{6,}$"},
        "network": {"const": "DISABLED"},
        "read_only_inputs": {"const": true},
        "resource_limits": {
          "type": "object",
          "required": ["wall_seconds", "memory_bytes", "processes", "output_bytes"],
          "properties": {
            "wall_seconds": {"type": "integer", "minimum": 1},
            "memory_bytes": {"type": "integer", "minimum": 1},
            "processes": {"type": "integer", "minimum": 1},
            "output_bytes": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
