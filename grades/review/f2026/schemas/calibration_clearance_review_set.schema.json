{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ne630:review:f2026:calibration-clearance-review-set:1.0.0",
  "title": "Immutable inert calibration visual-review set",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "selection_id",
    "review_set_id",
    "created_at",
    "selection",
    "clearance_request",
    "status",
    "normalization",
    "items",
    "contains_source_identifiers"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"$ref": "#/$defs/run_id"},
    "selection_id": {"$ref": "#/$defs/selection_id"},
    "review_set_id": {"$ref": "#/$defs/review_set_id"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "selection": {"$ref": "#/$defs/artifact_ref"},
    "clearance_request": {"$ref": "#/$defs/artifact_ref"},
    "status": {
      "enum": ["READY_FOR_VISUAL_REVIEW", "REQUIRES_SANITIZED_DERIVATIVE"]
    },
    "normalization": {
      "type": "object",
      "required": ["profile", "tool_name", "tool_version", "executable_sha256"],
      "properties": {
        "profile": {"const": "POPPLER_JPEG_IMAGE_ONLY_V1"},
        "tool_name": {"const": "ne630-review-pipeline"},
        "tool_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "executable_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "assignment_id",
          "submission_record_id",
          "disposition",
          "source_input_sha256",
          "source_input_byte_count",
          "review_artifact",
          "page_count",
          "page_sha256s",
          "pixel_dimensions",
          "automated_scan_status",
          "automated_scan_codes",
          "required_action"
        ],
        "properties": {
          "assignment_id": {"$ref": "#/$defs/assignment_id"},
          "submission_record_id": {"$ref": "#/$defs/submission_record_id"},
          "disposition": {
            "enum": ["SOURCE_RASTER", "SANITIZED_DERIVATIVE_RASTER"]
          },
          "source_input_sha256": {"$ref": "#/$defs/sha256"},
          "source_input_byte_count": {"type": "integer", "minimum": 1},
          "review_artifact": {"$ref": "#/$defs/artifact_ref"},
          "page_count": {"type": "integer", "minimum": 1, "maximum": 64},
          "page_sha256s": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {"$ref": "#/$defs/sha256"}
          },
          "pixel_dimensions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 1, "maximum": 3300},
                {"type": "integer", "minimum": 1, "maximum": 3300}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "automated_scan_status": {"$ref": "#/$defs/automated_scan_status"},
          "automated_scan_codes": {"$ref": "#/$defs/automated_scan_codes"},
          "required_action": {
            "enum": ["VISUAL_CLEARANCE_ALLOWED", "SANITIZED_DERIVATIVE_REQUIRED"]
          }
        },
        "additionalProperties": false
      }
    },
    "contains_source_identifiers": {"const": false}
  },
  "$defs": {
    "run_id": {"type": "string", "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"},
    "selection_id": {"type": "string", "pattern": "^SEL-[0-9]{6,}$"},
    "review_set_id": {"type": "string", "pattern": "^RSET-[0-9]{6,}$"},
    "assignment_id": {"enum": ["HW01", "HW02", "HW03", "HW04"]},
    "submission_record_id": {"type": "string", "pattern": "^HW0[1-4]-S[0-9]{3,}-V[0-9]{2,}$"},
    "automated_scan_status": {"enum": ["FAIL", "NEEDS_HUMAN_TRIAGE"]},
    "automated_scan_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+)*$"},
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "role", "path", "sha256", "byte_count", "media_type"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^ART-[0-9]{6,}$"},
        "role": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
