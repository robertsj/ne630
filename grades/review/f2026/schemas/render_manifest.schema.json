{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ne630:review:f2026:render-manifest:1.0.0",
  "title": "Deterministic Markdown render manifest",
  "type": "object",
  "required": [
    "schema_version",
    "render_id",
    "run_id",
    "created_at",
    "render_kind",
    "source",
    "template",
    "renderer",
    "output",
    "deterministic",
    "contains_source_identifiers"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "render_id": {"type": "string", "pattern": "^RND-[0-9]{6,}$"},
    "run_id": {"$ref": "#/$defs/run_id"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "render_kind": {"enum": ["DOSSIER_MARKDOWN", "REVIEW_QUEUE_MARKDOWN"]},
    "source": {"$ref": "#/$defs/artifact_ref"},
    "template": {"$ref": "#/$defs/artifact_ref"},
    "renderer": {
      "type": "object",
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "output": {"$ref": "#/$defs/artifact_ref"},
    "deterministic": {"const": true},
    "contains_source_identifiers": {"const": false}
  },
  "$defs": {
    "run_id": {"type": "string", "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+)*$"},
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "role", "path", "sha256", "byte_count", "media_type"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^ART-[0-9]{6,}$"},
        "role": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
