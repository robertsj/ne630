{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ne630:review:f2026:product-calibration-review:1.0.0",
  "title": "Qualitative product-calibration review",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "run_id",
    "selection_id",
    "dossier_id",
    "configuration_id",
    "config_sha256",
    "reference_manifest_sha256",
    "created_at",
    "updated_at",
    "assignment_id",
    "submission_record_id",
    "pseudonym",
    "review_mode",
    "reviewer",
    "prompt_version",
    "codebook_version",
    "coverage",
    "product_observations",
    "uncertainties",
    "selected_excerpts",
    "draft_comments",
    "ownership_question",
    "key_disagreements",
    "process_findings",
    "human_review",
    "release",
    "numeric_scoring_present",
    "contains_discourse_data",
    "contains_source_identifiers"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "review_id": {"type": "string", "pattern": "^REV-[0-9]{6,}$"},
    "run_id": {"$ref": "#/$defs/run_id"},
    "selection_id": {"type": "string", "pattern": "^SEL-[0-9]{6,}$"},
    "dossier_id": {"type": "string", "pattern": "^DOS-[0-9]{6,}$"},
    "configuration_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "reference_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "assignment_id": {"$ref": "#/$defs/assignment_id"},
    "submission_record_id": {"$ref": "#/$defs/submission_record_id"},
    "pseudonym": {"$ref": "#/$defs/pseudonym"},
    "review_mode": {"const": "PRODUCT_CALIBRATION"},
    "reviewer": {
      "type": "object",
      "required": ["reviewer_type", "reviewer_id", "provider", "model", "tool_version"],
      "properties": {
        "reviewer_type": {"enum": ["AGENT", "HUMAN"]},
        "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "provider": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "tool_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
      },
      "allOf": [
        {
          "if": {"properties": {"reviewer_type": {"const": "AGENT"}}, "required": ["reviewer_type"]},
          "then": {
            "properties": {
              "provider": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "tool_version": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"reviewer_type": {"const": "HUMAN"}}, "required": ["reviewer_type"]},
          "then": {
            "properties": {
              "provider": {"type": "null"},
              "model": {"type": "null"},
              "tool_version": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "codebook_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "coverage": {
      "type": "object",
      "required": ["status", "expected_problem_count", "reviewed_problem_ids", "reviewed_pages"],
      "properties": {
        "status": {"enum": ["COMPLETE", "PARTIAL", "NOT_CHECKABLE"]},
        "expected_problem_count": {"type": "integer", "minimum": 1},
        "reviewed_problem_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^P[1-9][0-9]*$"}
        },
        "reviewed_pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidence_locator"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "COMPLETE"}}, "required": ["status"]},
          "then": {
            "properties": {
              "reviewed_problem_ids": {"minItems": 1},
              "reviewed_pages": {"minItems": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "product_observations": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "criterion",
          "status",
          "consequence",
          "observation",
          "evidence_locators",
          "uncertainty",
          "key_disagreement"
        ],
        "properties": {
          "observation_id": {"type": "string", "pattern": "^OBS-[0-9]{6,}$"},
          "criterion": {"$ref": "#/$defs/criterion"},
          "problem_id": {"type": "string", "pattern": "^P[1-9][0-9]*$"},
          "subpart_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$"},
          "status": {"enum": ["SUPPORTED", "QUESTION", "NOT_CHECKABLE", "NOT_APPLICABLE"]},
          "consequence": {"enum": ["CONTEXT", "CONSEQUENTIAL"]},
          "observation": {"type": "string", "minLength": 1, "maxLength": 6000},
          "evidence_locators": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/evidence_locator"}
          },
          "uncertainty": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH"]},
          "key_disagreement": {"type": "boolean"}
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {"properties": {"status": {"const": "QUESTION"}}, "required": ["status"]},
                {"properties": {"consequence": {"const": "CONSEQUENTIAL"}}, "required": ["consequence"]}
              ]
            },
            "then": {"properties": {"evidence_locators": {"minItems": 1}}}
          }
        ],
        "additionalProperties": false
      },
      "allOf": [
        {"contains": {"type": "object", "properties": {"criterion": {"const": "PHYSICAL_AND_MATHEMATICAL_FORMULATION"}}, "required": ["criterion"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"criterion": {"const": "TECHNICAL_EXECUTION_AND_FINAL_RESULTS"}}, "required": ["criterion"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"criterion": {"const": "ASSUMPTIONS_AND_APPROXIMATION_JUDGMENT"}}, "required": ["criterion"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"criterion": {"const": "VERIFICATION_AND_PHYSICAL_INTERPRETATION"}}, "required": ["criterion"]}, "minContains": 1},
        {"contains": {"type": "object", "properties": {"criterion": {"const": "COMMUNICATION_AND_REPRODUCIBILITY"}}, "required": ["criterion"]}, "minContains": 1}
      ]
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uncertainty_id", "kind", "description", "impact", "evidence_locators"],
        "properties": {
          "uncertainty_id": {"type": "string", "pattern": "^UNC-[0-9]{6,}$"},
          "kind": {"enum": ["HANDWRITING", "SCAN", "OCR", "MISSING_PAGE", "AMBIGUOUS_NOTATION", "KEY_AMBIGUITY", "OTHER"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 4000},
          "impact": {"enum": ["NONE", "LOCAL", "MATERIAL", "NOT_CHECKABLE"]},
          "evidence_locators": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/evidence_locator"}
          }
        },
        "additionalProperties": false
      }
    },
    "selected_excerpts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["excerpt_id", "excerpt", "evidence_locator", "purpose"],
        "properties": {
          "excerpt_id": {"type": "string", "pattern": "^EXC-[0-9]{6,}$"},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence_locator": {"$ref": "#/$defs/evidence_locator"},
          "purpose": {"enum": ["OBSERVATION_SUPPORT", "UNCERTAINTY", "DRAFT_COMMENT", "KEY_DISAGREEMENT"]}
        },
        "additionalProperties": false
      }
    },
    "draft_comments": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["comment_id", "comment", "observation_ids", "evidence_locators"],
        "properties": {
          "comment_id": {"type": "string", "pattern": "^COM-[0-9]{6,}$"},
          "comment": {"type": "string", "minLength": 1, "maxLength": 2000},
          "observation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^OBS-[0-9]{6,}$"}
          },
          "evidence_locators": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/evidence_locator"}
          }
        },
        "additionalProperties": false
      }
    },
    "ownership_question": {
      "anyOf": [
        {
          "type": "object",
          "required": ["question_id", "question", "observation_ids", "evidence_locators"],
          "properties": {
            "question_id": {"type": "string", "pattern": "^OWN-[0-9]{6,}$"},
            "question": {"type": "string", "minLength": 1, "maxLength": 2000},
            "observation_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^OBS-[0-9]{6,}$"}
            },
            "evidence_locators": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/evidence_locator"}
            }
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "key_disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["disagreement_id", "description", "observation_ids", "evidence_locators", "instructor_decision_id"],
        "properties": {
          "disagreement_id": {"type": "string", "pattern": "^KEY-[0-9]{6,}$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 4000},
          "observation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^OBS-[0-9]{6,}$"}
          },
          "evidence_locators": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/evidence_locator"},
            "allOf": [
              {"contains": {"type": "object", "properties": {"source_role": {"const": "SUBMITTED_SOLUTION"}}, "required": ["source_role"]}, "minContains": 1},
              {"contains": {"type": "object", "properties": {"source_role": {"const": "SOLUTION_KEY"}}, "required": ["source_role"]}, "minContains": 1}
            ]
          },
          "instructor_decision_id": {
            "type": ["string", "null"],
            "pattern": "^DEC-[0-9]{6,}$"
          }
        },
        "additionalProperties": false
      }
    },
    "process_findings": {"type": "array", "maxItems": 0},
    "human_review": {"$ref": "#/$defs/human_review"},
    "release": {
      "type": "object",
      "required": ["student_facing", "state", "authorization_decision_id"],
      "properties": {
        "student_facing": {"const": false},
        "state": {"const": "NOT_AUTHORIZED"},
        "authorization_decision_id": {"type": "null"}
      },
      "additionalProperties": false
    },
    "numeric_scoring_present": {"const": false},
    "contains_discourse_data": {"const": false},
    "contains_source_identifiers": {"const": false}
  },
  "$defs": {
    "run_id": {"type": "string", "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"},
    "assignment_id": {"enum": ["HW01", "HW02", "HW03", "HW04"]},
    "pseudonym": {"type": "string", "pattern": "^S[0-9]{3,}$"},
    "submission_record_id": {"type": "string", "pattern": "^HW0[1-4]-S[0-9]{3,}-V[0-9]{2,}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+)*$"},
    "criterion": {
      "enum": [
        "PHYSICAL_AND_MATHEMATICAL_FORMULATION",
        "TECHNICAL_EXECUTION_AND_FINAL_RESULTS",
        "ASSUMPTIONS_AND_APPROXIMATION_JUDGMENT",
        "VERIFICATION_AND_PHYSICAL_INTERPRETATION",
        "COMMUNICATION_AND_REPRODUCIBILITY"
      ]
    },
    "evidence_locator": {
      "type": "object",
      "required": ["artifact_id", "artifact_sha256", "source_role", "logical_path", "locator_type", "extraction_method", "uncertainty"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^ART-[0-9]{6,}$"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_role": {"enum": ["SUBMITTED_SOLUTION", "PROBLEM_STATEMENT", "SOLUTION_KEY"]},
        "logical_path": {"$ref": "#/$defs/relative_path"},
        "locator_type": {"enum": ["FILE", "PDF_PAGE", "TEXT_LINES", "LABEL"]},
        "page": {"type": "integer", "minimum": 1},
        "printed_page_label": {"type": "string", "minLength": 1, "maxLength": 64},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "problem_id": {"type": "string", "pattern": "^P[1-9][0-9]*$"},
        "subpart_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$"},
        "extraction_method": {"enum": ["NATIVE_TEXT", "PDFTOTEXT", "OCR", "VISUAL"]},
        "uncertainty": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH"]},
        "excerpt": {"type": "string", "maxLength": 500}
      },
      "oneOf": [
        {"properties": {"locator_type": {"const": "FILE"}}},
        {"properties": {"locator_type": {"const": "PDF_PAGE"}}, "required": ["page"]},
        {"properties": {"locator_type": {"const": "TEXT_LINES"}}, "required": ["line_start", "line_end"]},
        {"properties": {"locator_type": {"const": "LABEL"}}, "required": ["label"]}
      ],
      "additionalProperties": false
    },
    "human_review": {
      "type": "object",
      "required": ["state", "reviewer_id", "reviewed_at", "decision_id"],
      "properties": {
        "state": {"enum": ["PENDING", "IN_REVIEW", "APPROVED", "REVISIONS_REQUIRED", "REJECTED"]},
        "reviewer_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "reviewed_at": {
          "anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]
        },
        "decision_id": {"type": ["string", "null"], "pattern": "^DEC-[0-9]{6,}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "PENDING"}}, "required": ["state"]},
          "then": {
            "properties": {"reviewer_id": {"type": "null"}, "reviewed_at": {"type": "null"}, "decision_id": {"type": "null"}}
          }
        },
        {
          "if": {"properties": {"state": {"const": "IN_REVIEW"}}, "required": ["state"]},
          "then": {
            "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "null"}, "decision_id": {"type": "null"}}
          }
        },
        {
          "if": {"properties": {"state": {"enum": ["APPROVED", "REVISIONS_REQUIRED", "REJECTED"]}}, "required": ["state"]},
          "then": {
            "properties": {
              "reviewer_id": {"type": "string", "minLength": 1},
              "reviewed_at": {"$ref": "#/$defs/timestamp"},
              "decision_id": {"type": "string", "pattern": "^DEC-[0-9]{6,}$"}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
