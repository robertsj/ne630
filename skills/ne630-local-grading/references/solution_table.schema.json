{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ne630/solution_table.schema.json",
  "title": "NE630 solution table row",
  "description": "One comparable answer atom from an instructor solution or a student submission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "course",
    "term",
    "homework_id",
    "problem_id",
    "answer_id",
    "source",
    "answer_kind",
    "value",
    "evidence",
    "extraction"
  ],
  "properties": {
    "schema_version": {
      "const": "ne630.solution_table.v0.1"
    },
    "course": {
      "type": "string",
      "examples": ["NE 630"]
    },
    "term": {
      "type": "string",
      "examples": ["Fall 2026"]
    },
    "homework_id": {
      "type": "string",
      "pattern": "^hw[0-9]{2}$"
    },
    "problem_id": {
      "type": "string",
      "pattern": "^p[0-9]{2}$"
    },
    "part_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "answer_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement_path": {
          "type": "string"
        },
        "statement_locator": {
          "type": "string",
          "description": "Problem heading, line range, DOM id, or other stable locator."
        },
        "statement_excerpt": {
          "type": "string"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "solution_path": {
          "type": "string"
        },
        "solution_locator": {
          "type": "string"
        },
        "expected_answer_id": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path"],
      "properties": {
        "role": {
          "enum": ["expected", "student"]
        },
        "student_group": {
          "type": "string",
          "description": "Normalized group id such as slug_userid; omit for expected rows."
        },
        "path": {
          "type": "string",
          "description": "Absolute or project-root-relative path to the normalized source artifact."
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "string",
          "description": "Page, heading, bbox, code cell, figure label, line range, or other source locator."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "route_guess": {
          "type": "string"
        }
      }
    },
    "answer_kind": {
      "enum": [
        "numerical",
        "algebraic",
        "short_answer",
        "code",
        "figure",
        "table",
        "mixed"
      ]
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/numerical_value"
        },
        {
          "$ref": "#/$defs/algebraic_value"
        },
        {
          "$ref": "#/$defs/short_answer_value"
        },
        {
          "$ref": "#/$defs/code_value"
        },
        {
          "$ref": "#/$defs/figure_value"
        },
        {
          "$ref": "#/$defs/table_value"
        },
        {
          "$ref": "#/$defs/mixed_value"
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compare_to_answer_id": {
          "type": "string"
        },
        "method": {
          "enum": ["exact", "numeric_tolerance", "symbolic_equivalence", "rubric", "manual"]
        },
        "status": {
          "enum": ["not_compared", "match", "near_match", "mismatch", "manual_review"]
        },
        "score_hint": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": ["text", "latex", "code", "figure", "table", "file"]
          },
          "text": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence", "needs_review"],
      "properties": {
        "method": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_review": {
          "type": "boolean"
        },
        "review_reason": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "numerical_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "const": "numerical"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "uncertainty": {
          "type": "number"
        },
        "tolerance_abs": {
          "type": "number",
          "minimum": 0
        },
        "tolerance_rel": {
          "type": "number",
          "minimum": 0
        },
        "significant_figures": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "algebraic_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "latex"],
      "properties": {
        "kind": {
          "const": "algebraic"
        },
        "latex": {
          "type": "string"
        },
        "normalized_latex": {
          "type": "string"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "display": {
          "type": "string"
        }
      }
    },
    "short_answer_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "const": "short_answer"
        },
        "text": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "code_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "code"
        },
        "language": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "figure_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "const": "figure"
        },
        "path": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "alt_text": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "table_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "table"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array"
          }
        },
        "path": {
          "type": "string"
        }
      }
    },
    "mixed_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": {
          "const": "mixed"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
